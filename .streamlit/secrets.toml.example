# Copy this file to .streamlit/secrets.toml and fill in the real values.
# secrets.toml is ignored by git. This example file is committed, so it must
# only ever contain placeholders.

[auth]
# Where people are sent back to after signing in and after signing out.
# At Auth0, this exact address must be entered in the application's
# Settings under BOTH "Allowed Callback URLs" and "Allowed Logout URLs".
# On your own computer:
redirect_uri = "http://localhost:8501/oauth2callback"
# Any long random text. It protects the "stay logged in" cookie.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
cookie_secret = "PASTE-A-LONG-RANDOM-TEXT-HERE"

# Lets the app ask Auth0 "is this email confirmed now?" right after someone
# clicks the confirmation link, so they do not have to sign in again.
expose_tokens = "access"

[auth.auth0]
# From the application's Settings page at Auth0. One teammate creates the
# application and shares these values privately (never in the repo or a
# group chat).
client_id = "PASTE-THE-CLIENT-ID-HERE"
client_secret = "PASTE-THE-CLIENT-SECRET-HERE"
# Replace only the PASTE part with the "Domain" from the same page,
# for example dev-abc123.eu.auth0.com
server_metadata_url = "https://PASTE-THE-DOMAIN-HERE/.well-known/openid-configuration"
# Ask for the password on every sign-in, so "Sign out" really signs out.
client_kwargs = { "prompt" = "login" }

[auth0_management]
# Lets the app send the confirmation email again ("Send the email again"
# button). At Auth0 this is a SECOND application, of the type "Machine to
# Machine", allowed only "update:users" on the "Auth0 Management API".
# Copy the Client ID and Client Secret from that application's Settings page.
client_id = "PASTE-THE-MACHINE-TO-MACHINE-CLIENT-ID-HERE"
client_secret = "PASTE-THE-MACHINE-TO-MACHINE-CLIENT-SECRET-HERE"

[supabase]
# The database. One teammate creates the Supabase project and shares these
# two values privately (never in the repo or a group chat).
# The "Project URL", shown by the "Connect" button at the top of the project.
url = "https://PASTE-THE-PROJECT-ID-HERE.supabase.co"
# The "Secret key" from Settings > API Keys (it starts with sb_secret_).
# It can read and change everything in the database. Do not use the
# "Publishable key" here: it is not allowed to read our tables.
secret_key = "PASTE-THE-SECRET-KEY-HERE"

# [admin]
# The students who may handle reports on the Admin page. Remove the "#" in
# front of "[admin]" and "emails" to switch it on, and put in the real
# @novasbe.pt addresses. Without this section nobody is an admin.
# emails = ["someone@novasbe.pt"]
