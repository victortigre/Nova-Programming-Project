# Copy this file to .env and fill in the real values.
# .env is ignored by git. This example file is committed, so it must only
# ever contain placeholders.
#
# Add one line here for every secret the app needs, for example:
# OPENROUTER_API_KEY=your-key-here
#
# The login (Auth0) and database (Supabase) secrets are not kept here. They
# live in .streamlit/secrets.toml; see .streamlit/secrets.toml.example.
